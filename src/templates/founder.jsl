--!strict
--[[
`founder-emblem`: the founder speaking. The supplied S3 logo is the hero, large and centered in
two flat concentric rules; the headline sits over it and the invitation and call to action under
it. No face, no figure: the mark is the signature.
]]
local art = require '../art'
local campaign = require '../campaign'
local canvas = require '../canvas'
local common = require './common'
local theme = require '../theme'

local Founder = {}

--- The logo's side, and the radii and widths of the rules around it.
local LogoSide = 700
local OuterRule, OuterWidth = 384, 3
local InnerRule, InnerWidth = 366, 10

function Founder.draw(surface: canvas.Canvas, poster: campaign.Poster, assets: common.Assets): number
  local zones = theme.Zones['founder-emblem']
  local figure = zones.figure
  local voice = theme.Voices[poster.voice]
  local centerX, centerY = (figure.left + figure.right) / 2, (figure.top + figure.bottom) / 2
  local rules = canvas.path(surface)
    :ring(centerX, centerY, OuterRule, OuterRule - OuterWidth)
    :ring(centerX, centerY, InnerRule, InnerRule - InnerWidth)

  common.header(surface, poster, assets, zones.header, 1, 'center')
  canvas.fill(surface, rules, voice.structure)

  local left, top = centerX - LogoSide / 2, centerY - LogoSide / 2

  canvas.screen(surface, art.logo(assets.logo, canvas.pixels(surface, LogoSide)), left, top)
  canvas.mark(surface, 'logo', 'emblem', theme.box(left, top, left + LogoSide, top + LogoSide))
  canvas.mark(surface, 'figure', 'rules', theme.box(centerX - OuterRule, centerY - OuterRule, centerX + OuterRule, centerY + OuterRule))
  common.support(surface, poster, assets, zones.support, 'center')
  common.cta(surface, poster, assets, zones.cta)
  common.footer(surface, poster, assets)

  -- Two rings and the logo.
  return 3
end

return Founder
