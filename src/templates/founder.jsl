--!strict
--[[
`founder-emblem`: the founder speaking, in the recruitment poster's own order. The headline is
the hook at the top; the founder's own S3 logo, large and centered in two flat concentric rules,
is the emblem under it; the subheadline is the mission under the emblem, with the supporting line
after it when the poster has one; the call to action strikes last. No face, no figure: the mark
is the signature.
]]
local art = require '../art'
local campaign = require '../campaign'
local canvas = require '../canvas'
local common = require './common'
local text = require '../text'
local theme = require '../theme'

local Founder = {}

--- The logo's side, and the radii and widths of the rules around it.
local LogoSide = 700
local OuterRule, OuterWidth = 384, 3
local InnerRule, InnerWidth = 366, 10

function Founder.draw(surface: canvas.Canvas, poster: campaign.Poster, assets: common.Assets): number
  local zones = theme.Zones['founder-emblem']
  local figure = zones.figure
  local voice = theme.Voices[poster.voice]
  local centerX, centerY = (figure.left + figure.right) / 2, (figure.top + figure.bottom) / 2
  local headline = text.stack({
    { text = poster.headline, style = common.headlineStyle(assets, 1, 'center'), what = 'headline' },
  }, zones.header, 0, poster.id)

  canvas.text(surface, headline[1], theme.Palette.pinkwhite, 'headline')

  local rules = canvas.path(surface)
    :ring(centerX, centerY, OuterRule, OuterRule - OuterWidth)
    :ring(centerX, centerY, InnerRule, InnerRule - InnerWidth)

  canvas.fill(surface, rules, voice.structure)

  local left, top = centerX - LogoSide / 2, centerY - LogoSide / 2

  local side = canvas.pixels(surface, LogoSide)

  canvas.screen(surface, art.founderLogo(assets.s3, side), left, top)
  canvas.mark(surface, 'logo', 'S3 emblem', theme.box(left, top, left + LogoSide, top + LogoSide))
  canvas.mark(surface, 'figure', 'rules', theme.box(centerX - OuterRule, centerY - OuterRule, centerX + OuterRule, centerY + OuterRule))

  local lower: { text.Entry } = {
    { text = poster.subheadline, style = common.subheadlineStyle(assets, 'center'), what = 'subheadline' },
  }

  local support = poster.support

  if support then
    table.insert(lower, { text = support, style = common.supportStyle(assets, 'center'), what = 'support' })
  end

  local blocks = text.stack(lower, zones.support, 34, poster.id)

  canvas.text(surface, blocks[1], voice.accent, 'subheadline')
  if blocks[2] then canvas.text(surface, blocks[2], theme.Palette.body, 'support') end

  common.cta(surface, poster, assets, zones.cta)
  common.footer(surface, poster, assets)

  -- Two rings and the logo.
  return 3
end

return Founder
