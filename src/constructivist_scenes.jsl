polygon(poster,{{1094,847},{732,718},{721,743},{1126,895}},Ink)
worker(poster,252,1023,0.77,-7,Shade,Lavender,Lavender,false)
worker(poster,913,1012,0.76,9,Shade,Lilac,Atom,true)
worker(poster,579,825,1.13,-3,Green,Paper,Lilac,false)
rectangle(poster,42,1495,1158,1598,Atom)
