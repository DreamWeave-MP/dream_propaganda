--!strict
-- What the suites share: the package's folder, the installed fonts, and stand-ins for the logos.
-- The real logos are their owners' files and aren't in the repository, so the suites draw with
-- squares of their own instead, like the real ones in shape and in nothing else: for the S3 logo
-- an opaque ring on near-black, and for the DreamWeave logo a ring cut out of a clear square.
-- They are only ever written under target/.
local fs = require '@dream/fs'
local magick = require '@magick'
local path = require '@magick/path'
local propaganda = require '@dream-propaganda'
local truetype = require '@truetype'

local Support = {}

--- Where the fonts are, as the command line's default has them.
Support.FontDirectory = '/usr/share/fonts/google-noto'

--- The package's folder, from this file's chunk name: `jess package test` runs the suites from
--- whatever folder it was called in.
function Support.root(): string
  local source = debug.info(1, 's')
  local first = string.sub(source, 1, 1)
  local file = if first == '@' or first == '=' then string.sub(source, 2) else source

  return string.match(file, '^(.*)/tests/[^/]*$') or '.'
end

--- A font the campaign sets copy in, or an error saying what to install.
local function font(file: string): truetype.Font
  local location = fs.join(Support.FontDirectory, file)

  if not fs.isFile(location) then
    error(`{location} is missing: the suites set copy in Noto Sans and Noto Sans Mono, so install them`, 0)
  end

  return truetype.load(location)
end

--- The stand-in S3 logo: opaque, on near-black.
function Support.s3Logo(): magick.Image
  local image = magick.new(512, 512, '#050505')

  path.new():ring(256, 256, 200, 170):fill(image, '#DA96E0')

  return image
end

--- The stand-in DreamWeave logo: a ring on clear.
function Support.dreamweaveLogo(): magick.Image
  local image = magick.new(512, 512)

  path.new():ring(256, 256, 240, 200):fill(image, '#A269A7')

  return image
end

--- The fonts and the stand-in logo, read once.
local cached: propaganda.Assets? = nil

function Support.assets(): propaganda.Assets
  if cached then return cached end

  local theme = propaganda.theme
  local assets: propaganda.Assets = {
    fonts = { display = font(theme.Fonts.display), support = font(theme.Fonts.support), mono = font(theme.Fonts.mono) },
    s3 = Support.s3Logo(),
    dreamweave = Support.dreamweaveLogo(),
  }

  cached = assets

  return assets
end

--- A file's bytes as a string, raising the read's own message when there are none.
function Support.read(location: string): string
  local data, problem = fs.readFile(location)
  if not data then error(problem, 0) end

  return buffer.tostring(data)
end

--- The package's own copy, decoded.
function Support.campaign(): propaganda.Campaign
  return propaganda.campaign.decode(Support.read(fs.join(Support.root(), 'posters.toml')), 'posters.toml')
end

--- The package's own editions, decoded.
function Support.editions(): { [string]: propaganda.Edition }
  local text = Support.read(fs.join(Support.root(), 'editions.toml'))

  return propaganda.campaign.decodeEditions(text, Support.campaign(), 'editions.toml')
end

--- The DreamWind campaign's files.
Support.DreamWind = 'campaigns/dreamwind'

--- The DreamWind announcement's copy, decoded.
function Support.dreamwind(): propaganda.Campaign
  local path = fs.join(Support.root(), Support.DreamWind, 'posters.toml')

  return propaganda.campaign.decode(Support.read(path), path)
end

--- The DreamWind announcement's editions, decoded.
function Support.dreamwindEditions(): { [string]: propaganda.Edition }
  local path = fs.join(Support.root(), Support.DreamWind, 'editions.toml')

  return propaganda.campaign.decodeEditions(Support.read(path), Support.dreamwind(), path)
end

--- A scratch folder under the package's target/, emptied.
function Support.scratch(name: string): string
  local folder = fs.join(Support.root(), 'target', 'tests', name)

  if fs.isDir(folder) then
    local removed, problem = fs.remove(folder, { recursive = true })
    if not removed then error(problem, 0) end
  end

  local made, problem = fs.mkdir(folder, { recursive = true })
  if not made then error(problem, 0) end

  return folder
end

return Support
