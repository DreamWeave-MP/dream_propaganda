--!strict
-- The same inputs make the same pixels and the same file: one poster of each template drawn
-- twice, and the PNGs compared byte for byte.
local magick = require '@magick'
local propaganda = require '@dream-propaganda'
local support = require './support'
local test = require '@jess/test'

local expect = test.expect
local suite = test.new()

for _, index in { 1, 3, 7 } do
  suite.it(`draws poster {index} the same twice, to the byte`, function()
    local poster = support.campaign().posters[index]
    local first = magick.png(propaganda.render(poster, support.assets()).image)
    local second = magick.png(propaganda.render(poster, support.assets()).image)

    expect(buffer.len(first) > 0).toBe(true)
    expect(buffer.tostring(first) == buffer.tostring(second)).toBe(true)
  end)
end

suite.it('draws only colors of the palette where the logo is not', function()
  local poster = support.campaign().posters[7]
  local rendered = propaganda.render(poster, support.assets())
  local palette: { [number]: boolean } = {}

  for _, hex in propaganda.theme.Palette do
    local channels = magick.color(hex)

    palette[channels[1] * 65536 + channels[2] * 256 + channels[3]] = true
  end

  -- Away from the edges of shapes, where coverage blends two palette colors, every pixel of the
  -- diagram's bars and the panel is a palette color itself.
  for _, point in { { 300, 785 }, { 300, 915 }, { 300, 1045 }, { 100, 1500 }, { 600, 900 } } do
    local red, green, blue = rendered.image:get(point[1], point[2])

    expect(palette[red * 65536 + green * 256 + blue]).toBe(true)
  end
end)

return suite
